{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-27",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "durable_objects": {
    "bindings": [{ "name": "DEMO_AI_BUDGET", "class_name": "DemoAiBudget" }]
  },
  "migrations": [
    { "tag": "demo-ai-v1", "new_sqlite_classes": ["DemoAiBudget"] }
  ],
  "ratelimits": [
    { "name": "DEMO_AI_RATE", "namespace_id": "1501", "simple": { "limit": 3, "period": 60 } }
  ],
  "observability": {
    "enabled": true
  }
}
